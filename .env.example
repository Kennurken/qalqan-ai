# Qalqan AI v5.1 — Environment Variables
# Барлығы тегін API кілттер, карта қажет емес

# ===== AI ПРОВАЙДЕРЛЕР =====

# Groq — НЕГІЗГІ AI (14,400 req/day тегін!)
# Тіркелу: https://console.groq.com → API Keys → Create
# Карта: ҚАЖЕТ ЕМЕС
GROQ_API_KEY=

# Gemini — BACKUP AI (250 req/day) + Vision (скриншот)
# Тіркелу: https://aistudio.google.com/apikey → Create API Key
# Карта: ҚАЖЕТ ЕМЕС
GEMINI_API_KEY=

# ===== БАЗА ДАННЫХ =====

# Supabase — репорты, апелляции, check_logs (бесплатно)
# Тіркелу: https://supabase.com → New project → Settings → API
# МАҢЫЗДЫ: service_role кілтін пайдалану (anon емес) — бэкенд үшін
# МАҢЫЗДЫ: осы кілт ешқашан git-ке, extension кодына түспеуі керек
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ===== TELEGRAM =====

# Telegram Bot — /check /report /stats + inline mode
# Тіркелу: https://t.me/BotFather → /newbot → copy token
TELEGRAM_BOT_TOKEN=

# Admin chat ID (апелляциялар/шағымдар жіберу үшін)
# Алу: https://t.me/userinfobot → "Your ID"
TELEGRAM_CHAT_ID=

# Public threat channel ID (опц.) — қауіп туралы автохабарламалар үшін
TELEGRAM_CHANNEL_ID=

# Боттың скриншот-превьюін қосу (опц.): BOT_SCREENSHOTS=true
BOT_SCREENSHOTS=

# Webhook secret — setWebhook кезінде Telegram-ға жіберіледі
# Генерация: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Deployed API base URL (webhook registration үшін)
# Мысал: https://qalqan-ai-nu.vercel.app
QALQAN_API_URL=

# ===== ҚАУІП БАЗАЛАРЫ =====

# PhishTank (фишинг URL базасы)
# Тіркелу: https://phishtank.org/api_register.php
# Карта: ҚАЖЕТ ЕМЕС
PHISHTANK_API_KEY=

# Google Safe Browsing (зиянды URL базасы, 10,000 req/day)
# Тіркелу: https://console.cloud.google.com → APIs → Safe Browsing → Enable → Credentials
# Карта: ҚАЖЕТ ЕМЕС (free tier)
GOOGLE_SAFE_BROWSING_KEY=

# VirusTotal (70+ антивирус, 500 req/day)
# Тіркелу: https://www.virustotal.com/gui/join-us → API Key
VIRUSTOTAL_API_KEY=

# VT: белгісіз URL-ді сканерге ЖІБЕРУ (VT оны жариялайды — құпиялылық!).
# Әдепкі — тек іздеу (lookup-only). Белсенді жіберу үшін: VT_SUBMIT=true
VT_SUBMIT=

# URLhaus — кілт қажет емес (толық тегін)
# OpenPhish — кілт қажет емес (толық тегін)

# ===== КЭШ / RATE LIMIT (Upstash Redis) =====
# Тіркелу: https://upstash.com → Create Database (Global) → REST API
# Бос болса — in-memory fallback қолданылады (бір процесс ішінде ғана)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===== ҚАУІПСІЗДІК / ҚҰПИЯ =====

# Admin dashboard (/admin) құпиясы — Генерация: openssl rand -hex 16
ADMIN_SECRET=

# Cron-эндпоинттерді қорғау (/telegram/weekly-report, /health/check).
# МАҢЫЗДЫ: бос болса — бұл эндпоинттер БЛОКТАЛАДЫ (fail-closed), себебі олар
# Telegram-ға хабарлама жібереді. Генерация: openssl rand -hex 32
# Cron шақырғанда: curl -H "Authorization: Bearer <CRON_SECRET>" ...
CRON_SECRET=

# Секретсіз cron-ды әдейі ашық қалдыру (ҰСЫНЫЛМАЙДЫ): ALLOW_UNAUTHENTICATED_CRON=true
ALLOW_UNAUTHENTICATED_CRON=

# CORS: жарияланған кеңейтім ID-лері (үтірмен). Бос болса — кез келген
# chrome-extension:// рұқсат (dev). Мысал: QALQAN_EXTENSION_IDS=abc123,def456
QALQAN_EXTENSION_IDS=

# B2G серіктес API кілттері (банк/реттеуші). Формат: key1:Halyk,key2:KZ-CERT
QALQAN_API_KEYS=

# ===== VPS (Hetzner) DEPLOY =====
# Caddy авто-TLS алатын домен (мыс. api.qalqan.kz). deploy/ қараңыз.
DOMAIN=
# Supabase Postgres backup үшін (deploy/crontab pg_dump).
# Settings → Database → Connection string (URI)
SUPABASE_DB_URL=

# ===== ML МОДЕЛЬ (XLM-RoBERTa, ml/serve_model.py) =====
# Fine-tuned модель Vercel функциясына сыймайды → бөлек сервис ретінде іске қосылады
# (VPS / үй GPU / HF Space): cd ml && python serve_model.py  →  http://<host>:8001
# Бос болса — ML tier өткізіліп жіберіледі (pipeline бұрынғыша жұмыс істейді).
ML_SERVICE_URL=

# ===== ДЕМО РЕЖИМІ =====
# DEMO_MODE=true  ← презентация/демо кезінде қосыңыз (Groq/Gemini шақырылмайды)
DEMO_MODE=
