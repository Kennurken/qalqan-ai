{
    "manifest_version": 3,
    "name": "Qalqan AI — Cyber Shield",
    "short_name": "Qalqan AI",
    "version": "5.2.0",
    "description": "AI-powered cybersecurity: phishing, pyramid scheme, gambling & gov procurement fraud detection for Kazakhstan",
    "homepage_url": "https://github.com/Kennurken/qalqan-ai",
    "permissions": [
        "activeTab",
        "tabs",
        "storage",
        "notifications",
        "scripting",
        "alarms",
        "contextMenus"
    ],
    "host_permissions": [
        "https://*/*",
        "http://*/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "index.html",
        "default_title": "Qalqan AI — Check site safety",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "https://*/*",
                "http://*/*"
            ],
            "js": [
                "content.js",
                "fingerprint-detector.js"
            ],
            "run_at": "document_idle",
            "all_frames": false
        },
        {
            "matches": [
                "*://*.google.com/search*",
                "*://*.google.kz/search*",
                "*://*.google.ru/search*",
                "*://yandex.kz/search*",
                "*://yandex.ru/search*",
                "*://*.bing.com/search*",
                "*://duckduckgo.com/*",
                "*://go.mail.ru/search*",
                "*://*.ecosia.org/search*",
                "*://search.brave.com/search*",
                "*://*.startpage.com/*"
            ],
            "js": [
                "search-guard.js"
            ],
            "run_at": "document_end",
            "all_frames": false
        },
        {
            "matches": [
                "*://web.telegram.org/*",
                "*://web.whatsapp.com/*"
            ],
            "js": [
                "messenger-guard.js"
            ],
            "run_at": "document_end",
            "all_frames": false
        },
        {
            "matches": [
                "https://*/*",
                "http://*/*"
            ],
            "js": [
                "form-guard.js"
            ],
            "run_at": "document_idle",
            "all_frames": false
        }
    ],
    "content_security_policy": {
        "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://qalqan-ai-nu.vercel.app;"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}