{
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/report/generate",
      "schedule": "0 7 1 * *"
    },
    {
      "path": "/telegram/weekly-report",
      "schedule": "0 9 * * 0"
    }
  ]
}
