{
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/report/generate",
      "schedule": "0 7 1 * *"
    },
    {
      "path": "/telegram/weekly-report",
      "schedule": "0 9 * * 0"
    },
    {
      "path": "/health/check",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/cron/brand-watch",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/cron/refresh-feeds",
      "schedule": "0 */6 * * *"
    }
  ]
}
