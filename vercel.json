{
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/ping",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/report/generate",
      "schedule": "0 7 1 * *"
    }
  ]
}
